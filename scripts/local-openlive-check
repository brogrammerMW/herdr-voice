#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "${repo_root}/local-openlive"
# Minimums match local-openlive/package.json engines; pnpm-lock.yaml stays exact either way.
node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' || { echo "Node 22 or later is required" >&2; exit 1; }
test "$(pnpm --version | cut -d. -f1)" -ge 10 || { echo "pnpm 10 or later is required" >&2; exit 1; }
pnpm build
pnpm check
pnpm test
node scripts/check-runtime.mjs
